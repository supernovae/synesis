# Synesis local compose environment.
#
# Copy this file to .env before running:
#   cp .env.example .env
#   podman compose -f podman-compose.yaml up -d
#
# These defaults are for localhost development only. Do not reuse them for
# internet-facing Helm, Kubernetes, or OpenShift deployments.

# Image tags used by podman-compose.yaml.
SYNESIS_IMAGE_TAG=latest
SYNESIS_WEBUI_IMAGE_TAG=v0.9.6
SYNESIS_NORNICDB_IMAGE_TAG=v1.2.3

# Local-only shared tokens/secrets. Replace if you share the stack with others.
SYNESIS_INTERNAL_SERVICE_TOKEN=local-dev-internal-token
SYNESIS_PAT_PEPPER=local-dev-pat-pepper
SYNESIS_ADMIN_SESSION_TOKEN_KEY=local-dev-session-token-key
WEBUI_SECRET_KEY=local-dev-webui-secret-key

# Local host ports.
SYNESIS_LOCAL_WEBUI_PORT=3000
SYNESIS_LOCAL_ADMIN_PORT=8081
SYNESIS_LOCAL_PLANNER_PORT=8082
SYNESIS_LOCAL_YARN_PORT=8000
SYNESIS_LOCAL_MCP_PORT=8100
SYNESIS_LOCAL_ADMIN_MCP_PORT=8102
SYNESIS_LOCAL_POSTGRES_PORT=5432
SYNESIS_LOCAL_REDIS_PORT=6379
SYNESIS_LOCAL_SEARCH_PORT=8085
SYNESIS_LOCAL_NORNIC_BOLT_PORT=7687
SYNESIS_LOCAL_NORNIC_HTTP_PORT=7474
SYNESIS_LOCAL_KEYWORD_PORT=8086
SYNESIS_LOCAL_PREPROCESS_PORT=8087
SYNESIS_LOCAL_RERANKER_PORT=8088
SYNESIS_LOCAL_GLINER_PORT=8089
SYNESIS_LOCAL_SPAM_PORT=8090
SYNESIS_LOCAL_EMBEDDER_PORT=8091

# Chat planner model provider.
# Leave disabled for a smoke test. Enable and set a real OpenAI-compatible
# endpoint/key when you want Open WebUI chat to call a model.
SYNESIS_PLANNER_TS_LLM_ENABLED=false
SYNESIS_PLANNER_TS_LLM_BASE_URL=
SYNESIS_PLANNER_TS_LLM_API_KEY=
SYNESIS_PLANNER_TS_WRITER_MODEL=synesis-writer
SYNESIS_PLANNER_TS_PLANNER_MODEL=synesis-planner
SYNESIS_PLANNER_TS_CRITIC_MODEL=synesis-critic

# Coder/Yarn upstream OpenAI-compatible provider.
# Configure this when testing IDE/coder clients against http://localhost:8000.
SYNESIS_YARN_OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
SYNESIS_YARN_OPENAI_COMPAT_API_KEY=

# Optional provider keys visible to services that support provider discovery.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=

# Optional RAG/search profiles.
SYNESIS_NORNIC_PASSWORD=nornic-local-password
SYNESIS_EMBEDDER_URL=
SYNESIS_WEB_SEARCH_ENABLED=false
SYNESIS_WEB_SEARCH_URL=

# Optional OIDC for Synesis Admin. If unset, the admin UI starts but interactive
# login is disabled; use a real OIDC provider or PAT-backed API calls.
SYNESIS_KEYCLOAK_ISSUER_URL=
SYNESIS_KEYCLOAK_INTERNAL_ISSUER_URL=
