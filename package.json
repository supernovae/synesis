{
  "name": "synesis",
  "private": true,
  "scripts": {
    "lint": "eslint packages base/yarn-ts base/planner-ts base/vision-worker",
    "build": "npm run build --workspace=@synesis/mcp",
    "test": "npm test --workspace=@synesis/mcp",
    "synesis": "node packages/synesis-mcp/dist/cli.js"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.7"
  },
  "workspaces": [
    "packages/*",
    "base/planner-ts",
    "base/yarn-ts"
  ],
  "overrides": {
    "axios": "1.18.0",
    "esbuild": "0.28.1",
    "express-rate-limit": "8.5.1",
    "follow-redirects": "1.16.0",
    "hono": "4.13.5",
    "@hono/node-server": "2.0.12",
    "brace-expansion": "5.0.9",
    "fastify": "5.12.1",
    "zod": "4.4.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "ip-address": "10.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.69.0"
  }
}
