{
  "name": "synesis-planner-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "load:verify": "node ./scripts/load-verify.mjs",
    "bun:smoke": "bash ./scripts/bun-smoke.sh",
    "verify:gates": "bash ./scripts/verify-gates.sh",
    "rehearsal:new": "bash ./scripts/new-rehearsal-record.sh"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.73",
    "@fastify/rate-limit": "^11.0.0",
    "@openfga/sdk": "0.9.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@synesis/auth-contracts": "*",
    "@synesis/context-trust": "*",
    "@synesis/telemetry": "*",
    "@synesis/upper-harness": "*",
    "ai": "^6.0.208",
    "fastify": "^5.8.5",
    "ioredis": "^5.11.1",
    "neo4j-driver": "^6.1.0",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "axios": "1.16.0",
    "esbuild": "0.28.1",
    "vite": "8.0.7"
  }
}
