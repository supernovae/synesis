{
  "name": "synesis-planner-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "load:verify": "node ./scripts/load-verify.mjs",
    "bun:smoke": "bash ./scripts/bun-smoke.sh",
    "verify:gates": "bash ./scripts/verify-gates.sh",
    "rehearsal:new": "bash ./scripts/new-rehearsal-record.sh"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@langchain/core": "^1.1.40",
    "@langchain/langgraph": "^1.2.7",
    "@openfga/sdk": "^0.9.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@synesis/context-trust": "*",
    "@synesis/telemetry": "*",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "vite": "8.0.7"
  }
}
