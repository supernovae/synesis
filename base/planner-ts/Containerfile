ARG BASE_IMAGE=ghcr.io/supernovae/synesis/synesis-base-node-workspace:latest
FROM ${BASE_IMAGE} AS builder

USER 0
WORKDIR /opt/app-root/src

COPY base/planner-ts/tsconfig.json base/planner-ts/
COPY base/planner-ts/src base/planner-ts/src
RUN npm run build --workspace=base/planner-ts

RUN npm prune --omit=dev

FROM registry.access.redhat.com/ubi10/nodejs-24-minimal:latest

USER 1001
WORKDIR /opt/app-root/src

COPY --from=builder /opt/app-root/src/node_modules ./node_modules
COPY --from=builder /opt/app-root/src/packages ./packages
COPY --from=builder /opt/app-root/src/base/planner-ts/package.json base/planner-ts/package.json
COPY --from=builder /opt/app-root/src/base/planner-ts/dist base/planner-ts/dist

# Taxonomy + ontology config (single source of truth from planner-ts/config)
COPY base/planner-ts/config base/planner-ts/config

EXPOSE 8080

ENV NODE_ENV=production
ENV PORT=8080

CMD ["node", "--enable-source-maps", "base/planner-ts/dist/src/index.js"]
