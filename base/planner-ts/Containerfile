FROM registry.access.redhat.com/ubi9/nodejs-22:latest

WORKDIR /opt/app-root/src

# Copy workspace root and shared package first (context = repo root)
COPY package.json package-lock.json ./
COPY packages/synesis-telemetry/package.json packages/synesis-telemetry/
COPY base/planner-ts/package.json base/planner-ts/
RUN npm ci --workspace=packages/synesis-telemetry --workspace=base/planner-ts --ignore-scripts 2>/dev/null || npm ci

# Build shared package
COPY packages/synesis-telemetry/tsconfig.json packages/synesis-telemetry/
COPY packages/synesis-telemetry/src packages/synesis-telemetry/src
RUN npm run build --workspace=packages/synesis-telemetry

# Build planner-ts
WORKDIR /opt/app-root/src/base/planner-ts
COPY base/planner-ts/tsconfig.json ./tsconfig.json
COPY base/planner-ts/src ./src
COPY base/planner-ts/tests ./tests
COPY base/planner-ts/scripts ./scripts
RUN npm run build

WORKDIR /opt/app-root/src
RUN npm ci --omit=dev 2>/dev/null || true

EXPOSE 8080

ENV NODE_ENV=production
ENV PORT=8080

CMD ["node", "--enable-source-maps", "base/planner-ts/dist/src/index.js"]
