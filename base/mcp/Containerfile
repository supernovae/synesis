FROM registry.access.redhat.com/ubi9/python-311:latest

WORKDIR /opt/app-root/src

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

COPY requirements.txt .
# Explicitly target the SCL Python 3.11 — uv may otherwise discover /usr/bin/python3 (3.9).
RUN uv venv --python /opt/app-root/bin/python /opt/app-root/venv \
    && uv pip install --python /opt/app-root/venv/bin/python --no-cache -r requirements.txt

COPY app/ app/

USER 1001

ENV PATH="/opt/app-root/venv/bin:${PATH}"
ENV VIRTUAL_ENV=/opt/app-root/venv

EXPOSE 8100
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/opt/app-root/venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8100/health')"]

CMD ["/opt/app-root/venv/bin/python", "-m", "uvicorn", "app.server:app", "--host", "0.0.0.0", "--port", "8100"]
