# Build with repository root as context, e.g.:
#   podman build -f base/mcp/Containerfile .
ARG BASE_IMAGE=ghcr.io/supernovae/synesis/synesis-base-api:latest
FROM ${BASE_IMAGE}

USER 0
WORKDIR /opt/app-root/src

# MCP has no deps beyond base-api (fastapi, uvicorn, httpx, synesis-telemetry).
# If service-specific deps are added later, uncomment:
# COPY requirements.lock .
# RUN uv pip install --python /opt/app-root/venv/bin/python --no-cache --require-hashes -r requirements.lock

COPY base/mcp/app/ app/
# Shared with planner gate (single source in base/planner/app/integrity_core.py).
COPY base/planner/app/integrity_core.py app/integrity_core.py

USER 1001

EXPOSE 8100
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8100/health')"]

CMD ["uvicorn", "app.server:app", "--host", "0.0.0.0", "--port", "8100"]
