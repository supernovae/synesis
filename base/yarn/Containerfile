FROM registry.access.redhat.com/ubi9/python-311:latest

WORKDIR /opt/app-root/src

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

COPY requirements.txt .
# UBI + uv: `--system` targets /usr/local/... which is not writable in GHA buildx / some runners.
# Install into a venv under /opt/app-root (owned by root during build, readable by default user).
RUN uv venv /opt/app-root/venv \
    && uv pip install --python /opt/app-root/venv/bin/python --no-cache -r requirements.txt

COPY app/ app/

USER 1001

ENV PATH="/opt/app-root/venv/bin:${PATH}"
ENV VIRTUAL_ENV=/opt/app-root/venv

EXPOSE 8000
# Use venv interpreter explicitly — some runtimes reset PATH so `python` resolves to
# /opt/app-root/bin/python (no deps) instead of the venv (see CrashLoop: No module named uvicorn).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/opt/app-root/venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"]

CMD ["/opt/app-root/venv/bin/python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
