{
  "name": "synesis-yarn-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run",
    "bench:reducers": "tsx scripts/bench-reducers.ts",
    "verify:live": "tsx scripts/live-verify.ts",
    "verify:live:full": "SYNESIS_VERIFY_MODE=full tsx scripts/live-verify.ts",
    "verify:ab": "tsx scripts/ab-reducer-compare.ts",
    "verify:tiers": "tsx scripts/tier-compare.ts",
    "scaffold:reducer": "tsx scripts/scaffold-reducer.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.48",
    "@openfga/sdk": "^0.9.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "@synesis/context-trust": "*",
    "@synesis/manifest": "*",
    "@synesis/telemetry": "*",
    "ai": "^6.0.138",
    "fastify": "^5.8.4",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "tinypool": "^2.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
