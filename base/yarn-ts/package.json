{
  "name": "synesis-yarn-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "synesis-yarn-acp": "./dist/acp/synesis-yarn-acp.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run",
    "bench:reducers": "tsx scripts/bench-reducers.ts",
    "verify:live": "tsx scripts/live-verify.ts",
    "verify:live:full": "SYNESIS_VERIFY_MODE=full tsx scripts/live-verify.ts",
    "verify:ab": "tsx scripts/ab-reducer-compare.ts",
    "verify:tiers": "tsx scripts/tier-compare.ts",
    "scaffold:reducer": "tsx scripts/scaffold-reducer.ts",
    "eval": "tsx scripts/eval-gym.ts",
    "eval:list": "tsx scripts/eval-gym.ts --list",
    "eval:regression": "tsx scripts/eval-gym.ts --category governor_regression",
    "eval:e2e": "tsx scripts/eval-gym.ts --category e2e_build",
    "eval:export": "tsx scripts/eval-gym.ts --all --export sft --out eval-sft.jsonl"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@agentclientprotocol/sdk": "^0.18.0",
    "@ai-sdk/openai": "^3.0.51",
    "@openfga/sdk": "^0.9.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@synesis/agent-orchestration": "*",
    "@synesis/context-trust": "*",
    "@synesis/manifest": "*",
    "@synesis/mcp-tools": "*",
    "@synesis/telemetry": "*",
    "ai": "^6.0.148",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "tinypool": "^2.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "vite": "8.0.7"
  }
}
