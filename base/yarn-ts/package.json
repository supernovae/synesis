{
  "name": "synesis-yarn-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run",
    "bench:reducers": "tsx scripts/bench-reducers.ts",
    "verify:live": "tsx scripts/live-verify.ts",
    "verify:live:full": "SYNESIS_VERIFY_MODE=full tsx scripts/live-verify.ts",
    "verify:ab": "tsx scripts/ab-reducer-compare.ts",
    "scaffold:reducer": "tsx scripts/scaffold-reducer.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "*",
    "ai": "*",
    "fastify": "*",
    "ioredis": "*",
    "pg": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/pg": "*",
    "tsx": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
