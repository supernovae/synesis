FROM registry.access.redhat.com/ubi9/nodejs-22:latest

USER 0
WORKDIR /opt/app-root/src

# Copy workspace root and ALL workspace package.json files so npm can
# resolve the full workspace dependency tree from the lockfile.
COPY package.json package-lock.json ./
COPY packages/synesis-telemetry/package.json packages/synesis-telemetry/
COPY packages/synesis-context-trust/package.json packages/synesis-context-trust/
COPY base/yarn-ts/package.json base/yarn-ts/
COPY base/planner-ts/package.json base/planner-ts/
RUN npm ci --ignore-scripts

# Build shared packages
COPY packages/synesis-telemetry/tsconfig.json packages/synesis-telemetry/
COPY packages/synesis-telemetry/src packages/synesis-telemetry/src
RUN npm run build --workspace=packages/synesis-telemetry

COPY packages/synesis-context-trust/tsconfig.json packages/synesis-context-trust/
COPY packages/synesis-context-trust/src packages/synesis-context-trust/src
RUN npm run build --workspace=packages/synesis-context-trust

# Build yarn-ts
COPY base/yarn-ts/tsconfig.json base/yarn-ts/
COPY base/yarn-ts/src base/yarn-ts/src
RUN npm run build --workspace=base/yarn-ts

# Prune dev dependencies
RUN npm prune --omit=dev

USER 1001
EXPOSE 8000

ENV NODE_ENV=production
ENV PORT=8000

CMD ["node", "--enable-source-maps", "base/yarn-ts/dist/index.js"]
