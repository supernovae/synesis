ARG BASE_IMAGE=ghcr.io/supernovae/synesis/synesis-base-node-workspace:latest
FROM ${BASE_IMAGE} AS builder

USER 0
WORKDIR /opt/app-root/src

COPY base/yarn-ts/tsconfig.json base/yarn-ts/
COPY base/yarn-ts/src base/yarn-ts/src
RUN npm run build --workspace=base/yarn-ts

RUN npm prune --omit=dev

FROM registry.access.redhat.com/ubi10/nodejs-24-minimal:latest

USER 1001
WORKDIR /opt/app-root/src

COPY --from=builder /opt/app-root/src/node_modules ./node_modules
COPY --from=builder /opt/app-root/src/packages ./packages
COPY --from=builder /opt/app-root/src/base/yarn-ts/node_modules base/yarn-ts/node_modules
COPY --from=builder /opt/app-root/src/base/yarn-ts/package.json base/yarn-ts/package.json
COPY --from=builder /opt/app-root/src/base/yarn-ts/dist base/yarn-ts/dist

RUN node -e "const { createRequire } = require('node:module'); createRequire(process.cwd() + '/base/yarn-ts/dist/yarn-server.js').resolve('@fastify/rate-limit')"

EXPOSE 8000

ENV NODE_ENV=production
ENV PORT=8000

CMD ["node", "--enable-source-maps", "base/yarn-ts/dist/index.js"]
