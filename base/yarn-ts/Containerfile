FROM registry.access.redhat.com/ubi10/nodejs-24:latest

USER 0
WORKDIR /opt/app-root/src

# Copy workspace root and ALL workspace package.json files so npm can
# resolve the full workspace dependency tree from the lockfile.
COPY package.json package-lock.json ./
COPY packages/synesis-telemetry/package.json packages/synesis-telemetry/
COPY packages/synesis-context-trust/package.json packages/synesis-context-trust/
COPY packages/synesis-auth-contracts/package.json packages/synesis-auth-contracts/
COPY packages/synesis-oidc-auth/package.json packages/synesis-oidc-auth/
COPY packages/synesis-manifest/package.json packages/synesis-manifest/
COPY packages/synesis-mcp-tools/package.json packages/synesis-mcp-tools/
COPY packages/synesis-agent-orchestration/package.json packages/synesis-agent-orchestration/
COPY packages/synesis-upper-harness/package.json packages/synesis-upper-harness/
COPY base/yarn-ts/package.json base/yarn-ts/
COPY base/planner-ts/package.json base/planner-ts/
RUN npm ci --ignore-scripts

# Build shared packages
COPY packages/synesis-telemetry/tsconfig.json packages/synesis-telemetry/
COPY packages/synesis-telemetry/src packages/synesis-telemetry/src
RUN npm run build --workspace=packages/synesis-telemetry

COPY packages/synesis-context-trust/tsconfig.json packages/synesis-context-trust/
COPY packages/synesis-context-trust/src packages/synesis-context-trust/src
RUN npm run build --workspace=packages/synesis-context-trust

COPY packages/synesis-auth-contracts/tsconfig.json packages/synesis-auth-contracts/
COPY packages/synesis-auth-contracts/src packages/synesis-auth-contracts/src
RUN npm run build --workspace=packages/synesis-auth-contracts

COPY packages/synesis-oidc-auth/tsconfig.json packages/synesis-oidc-auth/
COPY packages/synesis-oidc-auth/src packages/synesis-oidc-auth/src
RUN npm run build --workspace=packages/synesis-oidc-auth

COPY packages/synesis-manifest/tsconfig.json packages/synesis-manifest/
COPY packages/synesis-manifest/src packages/synesis-manifest/src
RUN npm run build --workspace=packages/synesis-manifest

COPY packages/synesis-mcp-tools/tsconfig.json packages/synesis-mcp-tools/
COPY packages/synesis-mcp-tools/src packages/synesis-mcp-tools/src
RUN npm run build --workspace=packages/synesis-mcp-tools

COPY packages/synesis-agent-orchestration/tsconfig.json packages/synesis-agent-orchestration/
COPY packages/synesis-agent-orchestration/src packages/synesis-agent-orchestration/src
RUN npm run build --workspace=packages/synesis-agent-orchestration

COPY packages/synesis-upper-harness/tsconfig.json packages/synesis-upper-harness/
COPY packages/synesis-upper-harness/src packages/synesis-upper-harness/src
RUN npm run build --workspace=packages/synesis-upper-harness

# Build yarn-ts
COPY base/yarn-ts/tsconfig.json base/yarn-ts/
COPY base/yarn-ts/src base/yarn-ts/src
RUN npm run build --workspace=base/yarn-ts

# Prune dev dependencies
RUN npm prune --omit=dev

USER 1001
EXPOSE 8000

ENV NODE_ENV=production
ENV PORT=8000

CMD ["node", "--enable-source-maps", "base/yarn-ts/dist/index.js"]
